{
  "redirects": [
    {
      "source": "/dj",
      "destination": "https://ra.co/dj/csr.",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/index.md"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</profile.jsonld>; rel=\"describedby\"; type=\"application/ld+json\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "x-markdown-tokens", "value": "2712" }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "x-markdown-tokens", "value": "2712" }
      ]
    },
    {
      "source": "/profile.jsonld",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/ld+json; charset=utf-8"
        }
      ]
    }
  ]
}
